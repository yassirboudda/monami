[Unit]
Description=OctoHandy Chrome (CDP on loopback) for profile %i
After=oh-desktop@%i.service
Requires=oh-vnc@%i.service
[Service]
EnvironmentFile=/etc/octohandy/profiles/%i.env
User=oh-%i
Slice=oh-%i.slice
NoNewPrivileges=yes
Environment=LANG=fr_FR.UTF-8 XDG_RUNTIME_DIR=/run/user/%U XAUTHORITY=/home/oh-%i/.Xauthority
ExecStartPre=/bin/sleep 4
ExecStart=/usr/bin/google-chrome --user-data-dir=/home/oh-%i/.config/oh-chrome --remote-debugging-port=${OH_CDP_PORT} --remote-allow-origins=* --no-first-run --no-default-browser-check --password-store=basic --lang=fr-FR --disable-session-crashed-bubble --hide-crash-restore-bubble --start-maximized --disable-features=TranslateUI --disable-dev-shm-usage https://www.vinted.fr/
Restart=always
RestartSec=3
[Install]
WantedBy=multi-user.target
