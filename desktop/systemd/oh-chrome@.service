[Unit]
Description=MonAmi Chrome (CDP on loopback) for profile %i
After=oh-desktop@%i.service oh-proxy.service
Wants=oh-proxy.service
Requires=oh-vnc@%i.service
[Service]
Environment=OH_HOME_URL=https://www.google.fr
EnvironmentFile=/etc/octohandy/profiles/%i.env
User=oh-%i
Slice=oh-%i.slice
NoNewPrivileges=yes
Environment=TZ=Europe/Paris LANG=fr_FR.UTF-8 LANGUAGE=fr_FR:fr XDG_RUNTIME_DIR=/run/user/%U XAUTHORITY=/home/oh-%i/.Xauthority
ExecStartPre=/bin/sleep 4
ExecStart=/usr/bin/google-chrome --user-data-dir=/home/oh-%i/.config/oh-chrome --remote-debugging-port=${OH_CDP_PORT} --remote-allow-origins=* --no-first-run --no-default-browser-check --password-store=basic --disable-session-crashed-bubble --hide-crash-restore-bubble --start-maximized --disable-features=TranslateUI --disable-dev-shm-usage --proxy-server=http://127.0.0.1:3128 --proxy-bypass-list="<-loopback>" --disable-blink-features=AutomationControlled --disable-infobars --force-webrtc-ip-handling-policy=disable_non_proxied_udp --lang=fr-FR ${OH_HOME_URL}
Restart=always
RestartSec=3
[Install]
WantedBy=multi-user.target
