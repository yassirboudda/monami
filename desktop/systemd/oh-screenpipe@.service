[Unit]
Description=MonAmi Screenpipe (OCR of display) for profile %i
After=oh-desktop@%i.service docker.service
Requires=docker.service
[Service]
EnvironmentFile=/etc/octohandy/profiles/%i.env
EnvironmentFile=/etc/octohandy/gate.env
ExecStartPre=-/usr/bin/docker rm -f oh-screenpipe-%i
ExecStart=/usr/bin/docker run --rm --name oh-screenpipe-%i --network host --security-opt apparmor=unconfined -e DISPLAY=${DISPLAY} -e SCREENPIPE_API_KEY=${SCREENPIPE_API_KEY} -e TESSDATA_PREFIX=/usr/share/tesseract-ocr/5/tessdata -v /tmp/.X11-unix:/tmp/.X11-unix -v ${OH_HOME}/.Xauthority:/root/.Xauthority:ro -v ${OH_HOME}/.screenpipe:/root/.screenpipe octohandy-screenpipe record --port ${OH_SP_PORT} --disable-audio --app-context both --language french
ExecStop=/usr/bin/docker stop oh-screenpipe-%i
Restart=always
RestartSec=5
[Install]
WantedBy=multi-user.target
