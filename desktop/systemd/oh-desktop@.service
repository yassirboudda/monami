[Unit]
Description=MonAmi XFCE session for profile %i
After=oh-vnc@%i.service
Requires=oh-vnc@%i.service
[Service]
EnvironmentFile=/etc/octohandy/profiles/%i.env
User=oh-%i
Slice=oh-%i.slice
NoNewPrivileges=yes
Environment=TZ=Europe/Paris LANG=fr_FR.UTF-8 LC_ALL=C.UTF-8 XDG_RUNTIME_DIR=/run/user/%U XAUTHORITY=/home/oh-%i/.Xauthority
PAMName=login
ExecStartPre=/bin/sh -c 'for i in $(seq 1 30); do xdpyinfo -display ${DISPLAY} >/dev/null 2>&1 && exit 0; sleep 0.5; done; exit 1'
ExecStart=/usr/bin/dbus-launch --exit-with-session /usr/bin/startxfce4
# Xvnc blanks the display after 10 min without input: recordings and Screenpipe OCR would turn black.
ExecStartPost=/bin/sh -c 'sleep 5; xset -display ${DISPLAY} s off s noblank'
Restart=always
RestartSec=3
[Install]
WantedBy=multi-user.target
