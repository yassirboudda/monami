[Unit]
Description=OctoHandy API
After=network.target
Conflicts=hackathon-placeholder.service

[Service]
Type=simple
User=deploy
Group=deploy
WorkingDirectory=/home/deploy/apps/octohandy-api
EnvironmentFile=/home/deploy/apps/octohandy-api/.env
ExecStart=/home/deploy/apps/octohandy-api/.venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 3000
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
